# Copy this file to .env and replace the placeholders with real values.
# .env is listed in .gitignore and must NEVER be committed.
# Never put a real key in this file.

# API key for the AI service you use (name depends on the provider's library)
MY_SERVICE_API_KEY=your-key-here

# Model name your code should call (check the provider's current documentation)
MODEL_NAME=your-model-name

# Request timeout in seconds (environment values are strings; convert with int())
TIMEOUT_SECONDS=30
